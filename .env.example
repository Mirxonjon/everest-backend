# === Backend .env namunasi (serverда to'ldiring) ===

# PostgreSQL — serverdagi MAVJUD native postgres (yangi ko'tarilmaydi)
# Server: postgres / mirxonjon / 127.0.0.1:5432, har loyiha o'z bazasi
DATABASE_URL="postgresql://postgres:mirxonjon@127.0.0.1:5432/everest_case?schema=public"

# Server porti (host tarmoqда)
PORT=4055
DEFAULT_SLUG=506724

# MinIO — serverdagi MAVJUD cos-minio (127.0.0.1:9010)
# Bo'sh qoldirilsa (lokal dev) rasmlar diskka saqlanadi.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=everest

# Telegram bot (clientlar zakaz beradigan / zakaz tushadigan)
BOT_TOKEN=
ADMIN_CHAT_ID=

# Dashboard (admin panel) kirish
ADMIN_USER=admin
ADMIN_PASS=everest2026
ADMIN_SECRET=uzun-tasodifiy-maxfiy-kalit-ozgartiring

# Client (zakaz oluvchi) bot — /start da do'kon tugmasini ko'rsatadi
CLIENT_BOT_TOKEN=
SHOP_URL=https://everestcase.coachingzona.uz
